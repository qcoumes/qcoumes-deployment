TZ="Europe/Paris"

# Cron expression (supercronic), in TZ
BACKUP_SCHEDULE="0 4 * * *"

# Also run a backup each time the container starts
RUN_ON_START="false"

# SSH connection to the host running eMushpedia.
SOURCE_HOST="<host>"
SOURCE_PORT="22"
SOURCE_USER="<user>"

# List of wikis to backup
WIKIS="fr en es"

# restic snapshot host name and retention
SNAPSHOT_HOST="emushpedia"
KEEP_DAILY="7"
KEEP_WEEKLY="4"
KEEP_MONTHLY="12"

# Weekly `restic check --read-data-subset`, 1 = Monday ... 7 = Sunday
CHECK_WEEKDAY="7"
CHECK_SUBSET="10%"
