# -------------------------
# Application settings
# -------------------------
APP_NAME="Kanka Community Edition"
PUID=1000
PGID=1000
TZ="Europe/Brussels"

# Public URL where Kanka is reachable and contact information.
APP_URL=https://<host>
FRONT_DOMAIN="https://<host>"
APP_DOMAIN="https://<host>"
# Bare host name (no scheme), different from APP_DOMAIN, e.g. api.<host>: Kanka binds the API routes
# to it and drops their /api prefix, so a URL or the APP_URL host makes the API answer 404.
API_DOMAIN=<api-host>
APP_EMAIL=not@an.email

# Send e-mails (password recovery, notifications). Requires the MAIL_* settings below.
APP_EMAIL_ENABLED=false

# Port the application listens on inside the container.
# Do not expose this port to the internet!
# Instead point a reverse proxy to this port.
# APP_PORT=8081

# Allow users to self-register. Set to "false" to disable public signups.
APP_REGISTRATION_ENABLED=false

# Custom modules (user-defined entity types).
APP_CUSTOM_ENTITIES=true

# Require an invitation to register.
# When true, users need the invitation password set here.
APP_INVITATION_REQUIRED=true
APP_INVITATION_PASSWORD=<invitation-password>

# App environment.
#   - Use "local" only for the set-up process and testing.
#   - Use "production" for live systems.
APP_ENV=production

# Application encryption key (should be generated automatically).
# 32 random characters: openssl rand -hex 16
APP_KEY=<app-key>

# Database
DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=kanka
DB_USERNAME=sail
# DB_PASSWORD / DB_ROOT_PASSWORD: same values as MYSQL_PASSWORD / MYSQL_ROOT_PASSWORD below
DB_PASSWORD=<db-password>
DB_ROOT_PASSWORD=<db-root-password>

# Cache, sessions, queues
#BROADCAST_DRIVER=reverb
CACHE_DRIVER=redis
CACHE_PREFIX=kanka
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_DRIVER=sync

# Redis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

# Mail
# If you like for Kanka-CE to send E-Mails, e.g. for password recovery,
# you need to connect to an existing mail-server, as Kanka-CE does not come
# with an build-in mail server.
# However, Kanka-CE will work fine, even without an mail-server connection.

# You only need to change these, if you want to use something other
# than a smtp server. In most cases you can leve these unchanged.
#MAIL_DRIVER=smtp
#MAIL_MAILER=smtp
#MAIL_ENCRYPTION=tls

# Connect to your smtp server by providing the URL, Port,
# a (Kanka-CE-) user and the password for the (Kanka-CE-) user.
#MAIL_HOST=https://smtp.your-domain.com
#MAIL_PORT=1025
#MAIL_USERNAME=kanka-ce
#MAIL_PASSWORD=password

# Sender Information
#MAIL_FROM_ADDRESS=kanka-ce@your-domain.com
#MAIL_FROM_NAME="${APP_NAME}"

# Frontend / icons
# Important:
# In order for the icons to load, you need to provide a key here.
# 1.) Go to https://fontawesome.com/start to create an account.
# 2.) Create a (free) kit.
# 3.) Go to https://fontawesome.com/kits
# 3.1) Select you kit
# 3.2) copy the id either from the url: https://fontawesome.com/kits/<kit-id>/setup
#      or from the example: <script src="https://kit.fontawesome.com/<kit-id>.js" crossorigin="anonymous"></script>
#      and paste only the <kit-id> here.
FONTAWESOME_KIT=<kit-id>

# File storage
# For large deployments, with many worlds you can consider MinIO instead.
# Therefore see: .env.exmaple.minio
# However, for most usecases this should be fine
FILESYSTEM_DRIVER=public

# Search (Meilisearch)
SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
MEILISEARCH_HOST=http://meilisearch:7700
# Same value as MEILI_MASTER_KEY: openssl rand -hex 32
MEILISEARCH_KEY=<meili-master-key>
MEILI_MASTER_KEY=<meili-master-key>
MEILI_NO_ANALYTICS=true
# Migrate the search index in place when the (floating) meilisearch image changes version.
MEILI_UPGRADE_DB=true

# API rate limit, in requests per minute (Kanka default: 30).
API_THROTTLE_LIMIT=600


# -------------------------
# MariaDB settings
# -------------------------
MYSQL_DATABASE=kanka
MYSQL_USER=sail
MYSQL_PASSWORD=<db-password>
MYSQL_ROOT_PASSWORD=<db-root-password>
MYSQL_ROOT_HOST=%
